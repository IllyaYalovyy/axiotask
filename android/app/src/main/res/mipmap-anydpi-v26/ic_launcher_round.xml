<?xml version="1.0" encoding="utf-8"?>
<!-- Round adaptive launcher icon (API 26+). Launchers that request
     android:roundIcon get the SAME layers: an adaptive icon is masked by the
     system anyway, so a separate round composition would only differ on the
     legacy (pre-26) bitmaps, which mipmap-<density>/ic_launcher_round.png
     provides. Generated set — see tool/gen_icons.py. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
