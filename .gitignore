# Build-time OAuth client credentials (#229): the operator creates this file
# locally so a build can bundle the installed-app client. It carries a real
# client id/secret and MUST NEVER be committed — see tool/oauth_defines.sh and
# README, "Google sign-in setup".
tool/oauth_credentials.json

# alchemist golden-mismatch artifacts (never committed)
**/failures/

# Mutation-testing output (tool/mutation.sh): reports, logs, generated configs
# and survivors.tsv. Regenerated by a run; the committed part of #280 is the
# tooling and tool/mutation_baseline.tsv.
/mutation/
