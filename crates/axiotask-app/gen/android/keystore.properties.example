# Release signing template (#162) — DO NOT put real secrets here.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in the
# values for your release keystore. When `keystore.properties` is present the
# Gradle `release` build type is signed with it; when it is absent the release
# build stays unsigned and debug APKs keep building unchanged.
#
# Generate an upload keystore once (keep the .jks OUT of the repo — the root
# .gitignore already excludes *.jks / *.keystore):
#
#   keytool -genkey -v -keystore axiotask-upload.jks -alias axiotask \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to gen/android/app/ (an absolute path is fine).

storeFile=axiotask-upload.jks
storePassword=CHANGE_ME
keyAlias=axiotask
keyPassword=CHANGE_ME
